<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="order">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="total"    type="xs:decimal"/>
                <xs:element name="customer" type="CustomerType"/>
                <xs:element name="items"    type="ItemsType"/>
                <xs:element name="payment"  type="PaymentType"/>
            </xs:sequence>
            <xs:attribute name="id"        type="xs:integer"  use="required"/>
            <xs:attribute name="status"    type="xs:string"   use="required"/>
            <xs:attribute name="createdAt" type="xs:dateTime" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="CustomerType">
        <xs:sequence>
            <xs:element name="name"    type="xs:string"/>
            <xs:element name="email"   type="xs:string"/>
            <xs:element name="phone"   type="xs:string"/>
            <xs:element name="address" type="AddressType"/>
        </xs:sequence>
        <xs:attribute name="customerId" type="xs:integer" use="required"/>
    </xs:complexType>

    <xs:complexType name="AddressType">
        <xs:sequence>
            <xs:element name="city"    type="xs:string"/>
            <xs:element name="street"  type="xs:string"/>
            <xs:element name="details" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ItemsType">
        <xs:sequence>
            <xs:element name="food" type="FoodType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="FoodType">
        <xs:sequence>
            <xs:element name="name"       type="xs:string"/>
            <xs:element name="price"      type="xs:decimal"/>
            <xs:element name="expiration" type="xs:integer"/>
            <xs:element name="category"   type="xs:string"/>
            <xs:element name="available"  type="xs:boolean"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PaymentType">
        <xs:sequence>
            <xs:element name="amount"  type="xs:decimal"/>
            <xs:element name="method"  type="xs:string"/>
            <xs:element name="success" type="xs:boolean"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>

